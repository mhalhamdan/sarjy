# Add this site block to Caddy's configuration and reload Caddy. Caddy serves it over HTTPS on
# port 8000 of the server's hostname; browsers only allow microphone access over HTTPS.

srv1860690.hstgr.cloud:8000 {
	# Caddy runs in a container here, so it reaches the app through the Docker bridge gateway.
	# Set APP_BIND=172.17.0.1 in .env so the app is published on that address.
	reverse_proxy host.docker.internal:8000
}

# If Caddy runs on the host instead, keep APP_BIND at its default (127.0.0.1) and use:
#   reverse_proxy 127.0.0.1:8000
# If the Caddy container publishes its ports explicitly, add 8000 to that list too.
