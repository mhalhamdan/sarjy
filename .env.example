# Copy to .env and fill in the blanks.

# --- Required ---
OPENAI_API_KEY=
# The shared passcode people type to use the app.
ACCESS_PASSCODE=
# Signs the session cookie. At least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
POSTGRES_PASSWORD=

# Must be true when served over HTTPS (production). Keep false for http://localhost.
COOKIE_SECURE=false

# Only used when running the backend outside Docker (Compose sets its own for the app container).
DATABASE_URL=postgresql+asyncpg://sarjy:${POSTGRES_PASSWORD}@127.0.0.1:5432/sarjy

# --- Optional (defaults shown) ---
# APP_PORT=8000
# REALTIME_MODEL=gpt-realtime-2.1
# REALTIME_VOICE=marin
# REALTIME_REASONING_EFFORT=low
# TRANSCRIPTION_MODEL=gpt-live-transcribe
# SEARCH_MODEL=gpt-6.1-terra
# SEARCH_REASONING_EFFORT=low
# MEMORY_PROMPT_LIMIT=200
# SESSIONS_PER_USER_PER_DAY=50
# SEARCHES_PER_USER_PER_MINUTE=10
# PASSCODE_ATTEMPTS_PER_15_MIN=5
